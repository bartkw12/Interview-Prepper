{
  // Terminal > Run Task... (Windows uses "python"; Linux and macOS use "python3")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start app",
      "type": "shell",
      "command": "python run.py",
      "linux": { "command": "python3 run.py" },
      "osx": { "command": "python3 run.py" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Rebuild card data",
      "type": "shell",
      "command": "python scripts/build_data.py",
      "linux": { "command": "python3 scripts/build_data.py" },
      "osx": { "command": "python3 scripts/build_data.py" },
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m unittest -v",
      "linux": { "command": "python3 -m unittest -v" },
      "osx": { "command": "python3 -m unittest -v" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
