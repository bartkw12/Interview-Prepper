{
  // Run and Debug panel (Ctrl+Shift+D), or press F5 to run the selected entry.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Interview Prepper",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Interview Prepper (phone on same Wi-Fi)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Rebuild card data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
